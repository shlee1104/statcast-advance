{# Advance scouting report — two self-contained files from this one template.

   page == "card"    the dugout card: one printed page, and the file a coach
                     is sent. Static: no script, no data blob, no external
                     request, so it opens anywhere and prints as it looks.
   page == "detail"  the evidence behind the card, for whoever wants to check
                     a line. Data embedded as JSON, behaviour inline. Its only
                     external request is Chart.js, and it degrades to tables
                     if that is blocked, because the person reading may be on
                     stadium wifi.

   They were one file, card first. A reader who wanted the page a coach gets
   was handed twelve. `links`, when given, holds each file's name so the two
   can point at each other.

   No computation happens in here. Every number comes from the payload built
   by src/report.py, so the template cannot introduce a figure that no metric
   produced. #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ payload.meta.pitcher }} {{ payload.meta.season }} — {{ "Advance Report" if page == "card" else "Behind the card" }}</title>
{% if page == "detail" %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1" integrity="sha384-jb8JQMbMoBUzgWatfe6COACi2ljcDdZQ2OxczGA3bGNeWe+6DChMTBJemed7ZnvJ" crossorigin="anonymous"></script>
{% endif %}
<style>
:root{
  --bg:#f6f7f9; --card:#fff; --ink:#1c2024; --muted:#6b7280; --line:#e5e7eb;
  --head:#16202e; --accent:#2f6fb2; --warn:#b4472e; --good:#3b7a4e;
  --c1:#2f6fb2; --c2:#c8703a; --c3:#4d8c5f; --c4:#a8444a; --c5:#7a6aa8; --c6:#8a7355;
  --gap:16px; --radius:10px;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
     background:var(--bg);color:var(--ink);line-height:1.5;font-size:14px}
.wrap{max-width:1180px;margin:0 auto;padding:var(--gap)}

header.top{background:var(--head);color:#fff;padding:22px 26px;border-radius:var(--radius);
           margin-bottom:var(--gap)}
header.top h2{font-size:22px;font-weight:650;letter-spacing:-.01em}
header.top .sub{color:#9fb0c4;font-size:13px;margin-top:4px}
header.top .sub b{color:#d7e2ee;font-weight:600}
header.top a{color:#d7e2ee}
/* Under the card, on screen only: where the evidence is. */
.behind{font-size:13px;color:var(--muted);padding:0 6px 20px;max-width:90ch}
.behind a{color:var(--accent);font-weight:600}

/* Dugout card. The page a coach takes out, so it is set like a printed
   sheet: one page, dense, ruled, and nothing on it that needs JavaScript.

   Every size inside it is in em, and the sheet's own font size is a share of
   the card's width (cqw). So the card is the same picture at any width — on
   a monitor, and on a letter page, where that width is 7.8 inches — and a
   card that fits one page on screen fits it on paper. A narrow screen gets a
   reflowed single column in place of a page too small to read. */
.dugout{container-type:inline-size;background:var(--card);border-radius:var(--radius);
        margin-bottom:var(--gap);box-shadow:0 1px 2px rgba(16,24,40,.06);overflow:hidden}
.sheet{font-size:12px;font-size:1.14cqw;line-height:1.3;color:#15181c;
       padding:1.8em 2em 1.4em;
       -webkit-print-color-adjust:exact;print-color-adjust:exact}
.sheet .band{display:flex;justify-content:space-between;align-items:flex-end;gap:1em;
             background:#11161c;color:#fff;padding:.85em 1.2em}
.sheet .kind{font-size:.82em;letter-spacing:.18em;color:#aab4c0;text-transform:uppercase}
.sheet h1{font-size:2.3em;font-weight:800;letter-spacing:.02em;line-height:1.05;
          text-transform:uppercase}
.sheet .who{text-align:right;font-size:.95em;color:#cdd5de;line-height:1.5}
.sheet .who b{font-size:1.8em;color:#fff;letter-spacing:.04em;line-height:1.1}
.sheet .strip{display:flex;border:1px solid #11161c;border-top:none}
.sheet .strip div{flex:1;text-align:center;padding:.45em .2em;border-right:1px solid #cfd5dc}
.sheet .strip div:last-child{border-right:none}
.sheet .strip b{display:block;font-size:1.3em;font-variant-numeric:tabular-nums}
.sheet .strip span{font-size:.74em;letter-spacing:.08em;color:#5a6470;text-transform:uppercase}
.sheet h3{font-size:.9em;letter-spacing:.16em;font-weight:800;text-transform:uppercase;
          border-top:.22em solid #11161c;padding-top:.35em;margin:1.15em 0 .45em;
          display:flex;justify-content:space-between;align-items:baseline;gap:1.5em}
.sheet h3 span{font-weight:400;letter-spacing:.02em;color:#6a7480;font-size:.95em;
               text-transform:none;text-align:right}
.sheet .two{display:grid;grid-template-columns:1.72fr 1fr;gap:0 2em}
.sheet .three{display:grid;grid-template-columns:1fr 1fr 1fr;gap:0 1.6em}
/* Without this a table sets its column's minimum width, and on a phone the
   column, not the table's scroll box, runs off the side of the card. */
.sheet .two > div,.sheet .three > div{min-width:0}
.sheet table{font-size:1em;font-variant-numeric:tabular-nums}
.sheet th{font-size:.74em;letter-spacing:.08em;color:#5a6470;text-align:right;
          padding:.3em .5em;border-bottom:1.5px solid #11161c;font-weight:700;cursor:default}
.sheet th:hover{color:#5a6470;background:none}
.sheet td{text-align:right;padding:.34em .5em;border-bottom:1px solid #e3e7ec}
.sheet tbody tr:hover{background:none}
.sheet th.l,.sheet td.l{text-align:left}
.sheet .sw{display:inline-block;width:.8em;height:.8em;border-radius:.15em;margin-right:.5em;
           vertical-align:-.05em}
.sheet td.l b{display:inline-block;min-width:2.9em}
.sheet .n{color:#7a8490;font-size:.82em;white-space:nowrap}
.sheet .dim{color:#9aa3ad}
/* Situation pies: one row per batter side, the same five situations across. */
.pies{display:grid;grid-template-columns:4.4em repeat(5,1fr);gap:.2em .7em;align-items:center}
.piehead,.piecap{text-align:center;font-size:.8em;letter-spacing:.1em;font-weight:800;
                 color:#39424d;text-transform:uppercase}
.piecap{display:none}
.rowlab{font-size:.92em;font-weight:800;letter-spacing:.06em}
.pie{text-align:center}
.pie svg{display:block;width:100%;max-width:9.4em;height:auto;aspect-ratio:1;margin:0 auto}
.pie.thin svg{opacity:.4}
.pie text{text-anchor:middle;fill:#fff;font-weight:800}
.pie .pl{font-size:9.5px}
.pie .pv{font-size:11px}
.pie .sm.pl{font-size:8px}
.pie .sm.pv{font-size:9px}
.pie .pnone{fill:#8a94a0;font-weight:400;font-size:10px}
.pien{font-size:.78em;color:#6a7480;margin-top:.1em}
/* Zone maps: Savant's thirteen zones from the catcher's view, one map per
   pitch per side, each in its pitch's own colour. */
/* Columns are capped at their six-pitch width, so a two-pitch closer's maps
   sit together at the left, not one at each end of the page. */
.zones{display:grid;grid-template-columns:4.4em repeat(var(--pitches),minmax(0,12.5em));
       gap:.6em .9em;align-items:start}
.zones .rowlab{align-self:center}
.zm{text-align:center;min-width:0}
.zt{font-size:.92em;font-weight:800;margin-bottom:.25em;white-space:nowrap}
.zt span{font-weight:400;color:#6a7480;font-size:.85em}
.zbox{position:relative;width:100%;max-width:10em;aspect-ratio:1/1.06;margin:0 auto;
      border:1px solid #9aa3ad}
.zbox.thin{display:flex;align-items:center;justify-content:center;text-align:center;
           color:#8a94a0;line-height:1.25;
           background:repeating-linear-gradient(45deg,#fafbfc,#fafbfc .45em,#eef1f4 .45em,#eef1f4 .9em)}
.zbox.thin span{font-size:.82em}
.zouter{position:absolute;inset:0;display:grid;grid-template-columns:1fr 1fr;
        grid-template-rows:1fr 1fr}
.zo{position:relative;border:1px solid rgba(255,255,255,.7)}
.zo b{position:absolute;font-size:.8em;font-weight:700;line-height:1}
.zo11 b{top:.25em;left:.35em}.zo12 b{top:.25em;right:.35em}
.zo13 b{bottom:.25em;left:.35em}.zo14 b{bottom:.25em;right:.35em}
.zinner{position:absolute;left:21%;top:19%;width:58%;height:62%;display:grid;
        grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(3,1fr);
        border:.16em solid #11161c}
.zinner div{display:flex;align-items:center;justify-content:center;font-size:.84em;
            font-weight:700;border:1px solid rgba(255,255,255,.75)}
.zdark{color:#fff}
.keys ul{list-style:none}
.keys li{padding:.36em 0;border-bottom:1px dashed #d9dee4;line-height:1.36}
.keys li:last-child{border-bottom:none}
/* What pitch tracking cannot see, left for a pen: the two boxes a club's
   advance scout fills in from video and a stopwatch. */
.byhand .blanks div{display:flex;justify-content:space-between;border-bottom:1px solid #9aa3ad;
                    padding:.6em 0 .2em;color:#39424d}
.byhand .blanks span{color:#a3acb6;font-style:italic;font-size:.9em}
.sheet .byhand{grid-template-columns:1fr 1.72fr}
/* Real rules, not a striped background: a gradient drops lines when it is
   printed. More are in the page than a screen shows; print shows as many as
   the page has room for. */
.byhand .ruled{height:6.8em;overflow:hidden}
.byhand .ruled i{display:block;height:1.7em;border-bottom:1px solid #c5ccd4}
.sheet .foot{margin-top:.9em;border-top:1px solid #11161c;padding-top:.4em;font-size:.8em;
             color:#5a6470;display:flex;justify-content:space-between;gap:2.5em}
.sheet .foot span:last-child{white-space:nowrap;text-align:right}
@media screen{
  @container (max-width:900px){
    .sheet{font-size:12.5px;padding:14px 14px 12px}
    .sheet .band{flex-direction:column;align-items:flex-start}
    .sheet .who{text-align:left}
    .sheet .strip{flex-wrap:wrap}
    .sheet .strip div{flex:1 0 24%;border-bottom:1px solid #cfd5dc}
    .sheet .two,.sheet .three{grid-template-columns:1fr}
    .sheet h3{flex-direction:column;gap:.1em}
    .sheet h3 span{text-align:left}
    .pies,.zones{grid-template-columns:repeat(auto-fill,minmax(96px,1fr))}
    .pies{align-items:start}
    .pies .piehead,.pies .corner{display:none}
    /* Two lines high, so a pie under "Pitcher's count" lines up with one
       under "Even". */
    .piecap{display:flex;align-items:flex-end;justify-content:center;min-height:2.6em}
    .rowlab{grid-column:1/-1;margin-top:.5em}
    .sheet .foot{flex-direction:column;gap:.4em}
    .sheet .foot span:last-child{text-align:left;white-space:normal}
  }
}

section.card{background:var(--card);border-radius:var(--radius);padding:20px 24px;
             margin-bottom:var(--gap);box-shadow:0 1px 2px rgba(16,24,40,.06)}
section.card > h2{font-size:15px;font-weight:650;margin-bottom:4px}
section.card > .lede{font-size:13px;color:var(--muted);margin-bottom:16px;max-width:70ch}

.charts{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:var(--gap)}
/* min-width:0 lets a table inside a chart box scroll sideways on a phone
   instead of stretching the box, and the page, to the table's width. */
.chartbox{min-width:0;background:var(--card);border-radius:var(--radius);padding:20px 24px;
          box-shadow:0 1px 2px rgba(16,24,40,.06);margin-bottom:var(--gap)}
.chartbox h3{font-size:14px;font-weight:650;margin-bottom:2px}
.chartbox .lede{font-size:12px;color:var(--muted);margin-bottom:14px}
.chartbox .holder{position:relative;height:280px}
.chartbox h3.sub3{font-size:13px;margin:18px 0 6px}
/* Sequence graph: one panel per batter side, like the hitting plan. */
.sec3{font-size:14px;font-weight:650;margin:26px 0 4px;max-width:80ch}
.sec3.first{margin-top:10px}
.sec3 + .lede{font-size:13px;color:var(--muted);margin-bottom:14px;max-width:80ch}
.seqgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(380px,100%),1fr));gap:18px}
.seqpanel{border:1px solid var(--line);border-radius:8px;padding:12px 14px 8px}
.seqpanel h4{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;
             color:var(--head);margin-bottom:4px}
.seqpanel h4 .n{font-size:11px;font-weight:400;text-transform:none;letter-spacing:0;
                color:var(--muted);margin-left:6px}
.svgchart.seq{max-width:520px;margin:0 auto}
.svgchart .seqlab{font-size:11px;font-weight:700;paint-order:stroke;stroke:#fff;
                  stroke-width:3.5px;stroke-linejoin:round}
.seqnone{font-size:12px;color:var(--muted);text-align:center;margin:2px 0 6px}
.chartbox th,.chartbox td{padding:7px 7px}
canvas{max-height:280px}

table{width:100%;border-collapse:collapse;font-size:13px}
th{text-align:left;padding:8px 10px;border-bottom:2px solid var(--line);color:var(--muted);
   font-size:11px;text-transform:uppercase;letter-spacing:.05em;white-space:nowrap;
   cursor:pointer;user-select:none}
th:hover{color:var(--ink);background:#fafbfc}
td{padding:8px 10px;border-bottom:1px solid #f1f2f4;white-space:nowrap}
tbody tr:hover{background:#fafbfc}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
.scroll{overflow-x:auto}
.pos{color:var(--warn);font-weight:600}
.neg{color:var(--good)}
.dim{color:var(--muted)}

/* Zone maps: Savant's 3x3 strike zone floating inside the four outside
   regions, which is how a hitter pictures it. */
/* Small multiples: all six pitches at once, so comparison is by eye rather
   than by memory. A dropdown that swaps one grid forces the reader to hold
   the previous one in their head. */
.zgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));
       gap:18px;margin-top:4px}
.zpanel{border:1px solid var(--line);border-radius:8px;padding:10px 10px 6px}
.zpanel.thin{background:repeating-linear-gradient(45deg,#fbfbfc,#fbfbfc 6px,
             #f4f5f7 6px,#f4f5f7 12px);border-style:dashed}
.zpanel h4{font-size:12px;font-weight:650;margin-bottom:1px}
.zpanel .sub{font-size:11px;color:var(--muted);margin-bottom:8px}
.zpanel .warn{color:#8a5a22}
.zmap{position:relative;width:100%;aspect-ratio:1/1.05}
.zmap .outer{position:absolute;inset:0;display:grid;grid-template-columns:1fr 1fr;
             grid-template-rows:1fr 1fr;border-radius:4px;overflow:hidden}
.zmap .inner{position:absolute;left:22%;top:20%;width:56%;height:60%;
             display:grid;grid-template-columns:repeat(3,1fr);
             grid-template-rows:repeat(3,1fr);
             border:2px solid rgba(20,28,40,.6)}
.zcell{display:flex;flex-direction:column;align-items:center;justify-content:center;
       font-size:9px;line-height:1.15;border:1px solid rgba(255,255,255,.5);
       color:#16202e;font-variant-numeric:tabular-nums}
.zcell b{font-size:10px;font-weight:650}
.zcell i{font-style:normal;opacity:.6;font-size:8px}
.legend-inline{display:inline-flex;align-items:center;gap:6px;font-size:11px;
               color:var(--muted);margin-left:4px}
.legend-inline .ramp{display:inline-block;width:110px;height:11px;border-radius:3px;
                     border:1px solid var(--line)}
/* Count grid: one balls-by-strikes lattice per pitch. Colour is the lift, the
   text repeats it as a number, so the chart reads in black and white too. */
.cglegend{width:260px;max-width:100%;margin:4px 0 22px 4px;font-size:11px;color:var(--muted)}
.cglegend .ramp{height:11px;border-radius:3px;border:1px solid var(--line);
                -webkit-print-color-adjust:exact;print-color-adjust:exact}
.cglegend .ticks{position:relative;height:14px;margin-top:3px}
.cglegend .ticks span{position:absolute;transform:translateX(-50%);white-space:nowrap}
.cgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(196px,1fr));gap:16px}
.cgpanel h4{font-size:13px;font-weight:700;margin-bottom:0}
.cgpanel .sub{font-size:11px;color:var(--muted);margin-bottom:6px}
.cg{display:grid;grid-template-columns:16px repeat(3,1fr);gap:2px}
.cg-head{font-size:10px;color:var(--muted);display:flex;align-items:center;
         justify-content:center}
.cgc{aspect-ratio:1/0.82;display:flex;flex-direction:column;align-items:center;
     justify-content:center;border-radius:3px;color:#16202e;line-height:1.15;
     font-variant-numeric:tabular-nums;
     -webkit-print-color-adjust:exact;print-color-adjust:exact}
.cgc b{font-size:13px;font-weight:700}
.cgc i{font-style:normal;font-size:9.5px;opacity:.75}
.cgc.dark{color:#fff}
.cgc.dark i{opacity:.9}
.cgc.gated{background:#eef1f4;color:#9aa4ae;font-size:14px}
/* Outlined: the lift stands three standard errors clear of his usual rate. */
.cgc.clear{box-shadow:inset 0 0 0 2px #16202e}
.cgc.dark.clear{box-shadow:inset 0 0 0 2px #16202e,inset 0 0 0 3.5px #fff}
.cglegend .box{display:inline-block;width:12px;height:10px;border-radius:2px;
               box-shadow:inset 0 0 0 2px #16202e;vertical-align:-1px;margin-right:5px}
.cglegend .mark{margin-top:6px}
.cg-cap{display:flex;justify-content:space-between;font-size:10px;color:var(--muted);
        margin:3px 0 0 18px}
/* Outside-the-zone regions. The map draws four quadrants and lays the strike
   zone over their middle, so a label centred in a quadrant — or placed in the
   corner nearest the zone — ends up underneath the strike-zone box. Each label
   is pinned to its quadrant's OUTER corner, the only part of the quadrant the
   box can never cover. Before this, all four outside labels were hidden on
   the grids — including the 35% of Skubal's changeups that finish in zone 14. */
.oz{position:relative;border:1px solid rgba(255,255,255,.45);
    -webkit-print-color-adjust:exact;print-color-adjust:exact}
.oz .lab{position:absolute;display:flex;flex-direction:column;padding:5px 7px;
         line-height:1.15;color:#16202e;font-variant-numeric:tabular-nums}
.oz .lab b{font-size:11px;font-weight:700}
.oz .lab i{font-style:normal;font-size:8.5px;opacity:.7}
.oz-11 .lab{top:0;left:0;align-items:flex-start}
.oz-12 .lab{top:0;right:0;align-items:flex-end}
.oz-13 .lab{bottom:0;left:0;align-items:flex-start}
.oz-14 .lab{bottom:0;right:0;align-items:flex-end}
.oz.dark .lab,.zcell.dark{color:#fff}
/* Hand-drawn SVG charts (slope, movement): sized by viewBox so they scale to
   the column and print at full resolution. */
.svgchart{width:100%;height:auto;display:block;font-family:inherit}
.svgchart .grid{stroke:#eceff2;stroke-width:1}
.svgchart .zero{stroke:#c3cad2;stroke-width:1.2}
.svgchart .tick{font-size:10.5px;fill:#6b7280}
.svgchart .axis{font-size:11.5px;fill:#55606b}
.svgchart .slab{font-size:12.5px}
.svgchart .blab{font-size:12px;font-weight:700;fill:#1c2024}
.svgchart .bsub{font-size:10.5px;fill:#55606b}
.svgchart.move{max-width:640px}
select{padding:6px 10px;border:1px solid var(--line);border-radius:6px;background:#fff;
       font-size:13px;color:var(--ink)}
.controls{display:flex;gap:10px;align-items:center;margin-bottom:14px;flex-wrap:wrap}
.controls label{font-size:12px;color:var(--muted)}

.note{font-size:12px;color:var(--muted);margin-top:12px;max-width:80ch}
.gaps{background:#fdf4ec;border:1px solid #e9d3ba;color:#7a4f22;border-radius:var(--radius);
      padding:12px 16px;margin-bottom:var(--gap);font-size:13px}
.gaps code{background:#f5e6d5;padding:1px 5px;border-radius:3px;font-size:12px}
.nodata{color:var(--muted);font-size:13px;padding:10px 0}
footer{color:var(--muted);font-size:12px;padding:8px 4px 24px}
button.more{background:none;border:1px solid var(--line);border-radius:6px;padding:6px 12px;
            font-size:12px;color:var(--accent);cursor:pointer}
button.more:hover{background:#f3f6fa}

@media (max-width:720px){
  .charts{grid-template-columns:1fr}
}
/* Letter, because the card is cut to it: 7.8 by 10.3 inches inside the
   margins. On that page the card is exactly one sheet. The two write-in boxes
   take whatever height the rest leaves, so a pitcher with two pitches and one
   with seven both fill the page and neither runs onto a second. */
@page{size:letter;margin:.35in}
@media print{
  body{background:#fff}
  .wrap{max-width:none;padding:0}
  .chartbox,section.card{box-shadow:none;border:1px solid var(--line)}
  .dugout{box-shadow:none;border-radius:0;margin:0;break-after:page}
  .sheet{padding:0;height:10.2in;display:flex;flex-direction:column}
  .sheet > *{flex:none}
  .sheet > .byhand{flex:1 1 auto;min-height:0;overflow:hidden;grid-template-rows:minmax(0,1fr)}
  .byhand > div{display:flex;flex-direction:column;min-height:0}
  .byhand .ruled{flex:1 1 auto;height:auto;min-height:0}
  .controls,button.more,.behind{display:none}
  section.card,.chartbox{break-inside:avoid}
}
</style>
</head>
<body>
<div class="wrap">

{# ------------------------------------------------------------ dugout card
   One page, and a file of its own. Rendered here in the template rather than
   in JavaScript so it prints, and so there is no script to block: this is the
   page that gets folded into a back pocket.

   It prints what repeats and what a hitter can act on, and nothing else: see
   report._build_card for the rule, and gameplan.card_keys for which lines of
   the hitting plan are on it. The payload carries the rest. #}
{% set c = payload.card %}
{% set names = payload.display_names %}
{% macro pct(v, d=0) %}{% if v is none %}—{% else %}{{ ("%." ~ d ~ "f")|format(v * 100) }}%{% endif %}{% endmacro %}
{% macro num(v, d=1) %}{% if v is none %}—{% else %}{{ ("%." ~ d ~ "f")|format(v) }}{% endif %}{% endmacro %}
{# Inches of break as a scout writes them: whole numbers, and no "-0". #}
{% macro whole(v, signed=false) %}{% if v is none %}—{% elif v|round|int == 0 %}0{% else %}{{ (("%+d" if signed else "%d")|format(v|round|int)).replace("-", "−") }}{% endif %}{% endmacro %}
{# wOBA-scale numbers print the way scouts write them: .262, not 0.262. #}
{% macro woba(v) %}{% if v is none %}—{% else %}{{ ("%.3f"|format(v)).replace("0.", ".", 1) if v >= 0 else "%.3f"|format(v) }}{% endif %}{% endmacro %}
{% macro coach(p) %}{{ c.coach_names.get(p, names.get(p, p))|capitalize }}{% endmacro %}

{% if page == "card" %}
<section class="dugout" aria-label="Dugout card">
<div class="sheet">
  <div class="band">
    <div>
      <div class="kind">Advance report · dugout card</div>
      <h1>{{ payload.meta.pitcher }}</h1>
    </div>
    <div class="who">
      <b>{{ payload.meta.hand }}HP</b><br>
      {{ payload.meta.season }}{% if c.through %} · through {{ c.through }}{% endif %} ·
      {{ "{:,}".format(c.season.pitches) }} pitches · {{ c.season.games }} games ·
      {{ "{:,}".format(c.season.batters) }} batters
    </div>
  </div>
  <div class="strip">
    <div><b>{{ pct(c.season.k_rate, 1) }}</b><span>K</span></div>
    <div><b>{{ pct(c.season.bb_rate, 1) }}</b><span>BB</span></div>
    <div><b>{{ pct(c.season.whiff_rate, 1) }}</b><span>Whiff / swing</span></div>
    <div><b>{{ pct(c.season.chase_rate, 1) }}</b><span>Chase</span></div>
    <div><b>{{ pct(c.season.zone_rate, 1) }}</b><span>In zone</span></div>
    <div><b>{{ pct(c.season.first_strike_rate, 1) }}</b><span>1st-pitch strike</span></div>
    <div><b>{{ woba(c.season.xwoba) }}</b><span>xwOBA</span></div>
  </div>

  <div class="two">
    <div>
      <h3>Arsenal <span>velo = where he sits · IVB / HB = inches of break, HB + to his arm side</span></h3>
      <div class="scroll">
      <table>
        <thead><tr>
          <th class="l">Pitch</th><th>Velo</th><th>Max</th><th>vs L</th><th>vs R</th>
          <th>IVB</th><th>HB</th><th>Whiff</th><th>Chase</th>
        </tr></thead>
        <tbody>
        {% for a in c.arsenal %}
          <tr>
            <td class="l"><i class="sw" style="background:{{ c.colors[a.pitch_type] }}"></i><b>{{ c.short_names[a.pitch_type] }}</b>{{ coach(a.pitch_type) }}</td>
            <td>{{ num(a.sits_lo, 0) }}–{{ num(a.sits_hi, 0) }}</td>
            <td>{{ num(a.touches, 0) }}</td>
            <td{% if a.usage_L is not none and a.usage_L < c.rare_share %} class="dim"{% endif %}>{{ pct(a.usage_L) }}</td>
            <td{% if a.usage_R is not none and a.usage_R < c.rare_share %} class="dim"{% endif %}>{{ pct(a.usage_R) }}</td>
            <td>{{ whole(a.ivb) }}</td>
            <td>{{ whole(a.arm_run, true) }}</td>
            <td{% if a.swings < c.rate_min %} class="dim"{% endif %}>{{ pct(a.whiff_rate) }}</td>
            <td{% if a.chances < c.rate_min %} class="dim"{% endif %}>{{ pct(a.chase_rate) }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      </div>
    </div>
    <div>
      {% if c.recent.last_n %}
      <h3>Last {{ c.recent.last_n }} outings
        {% if c.recent.fastball %}<span>{{ c.short_names.get(c.recent.fastball, c.recent.fastball) }} velo{% if c.recent.velo_earlier is not none %} · {{ num(c.recent.velo_earlier) }} before that{% endif %}</span>{% endif %}</h3>
      <div class="scroll">
      <table>
        <thead><tr>
          <th class="l">Date</th><th>Pit</th><th>Velo</th><th>Whiff</th><th>K</th><th>BB</th>
        </tr></thead>
        <tbody>
        {% for g in c.recent.starts %}
          <tr>
            <td class="l">{{ g.day }}</td><td>{{ g.pitches }}</td>
            <td>{{ num(g.fb_velo) }}</td><td>{{ pct(g.whiff_rate) }}</td>
            <td>{{ g.strikeouts }}</td><td>{{ g.walks }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      </div>
      {% endif %}
    </div>
  </div>

  <h3>Pitch mix by situation <span>share of his pitches to that side in that situation · faded = fewer than 30 pitches</span></h3>
  <div class="pies">
    <div class="corner"></div>
    {% for p in c.pies[0].pies %}<div class="piehead">{{ p.label }}</div>{% endfor %}
    {% for row in c.pies %}
    <div class="rowlab">{{ row.label }}</div>
    {% for p in row.pies %}
    <div class="pie{% if not p.reliable %} thin{% endif %}">
      <div class="piecap">{{ p.label }}</div>
      <svg viewBox="0 0 {{ p.size }} {{ p.size }}" role="img"
           aria-label="{{ p.label }}, {{ row.label }}: {% for sl in p.slices %}{{ coach(sl.pitch) }} {{ pct(sl.share) }}{% if not loop.last %}, {% endif %}{% endfor %}">
        {% for sl in p.slices %}
        <g>
          <title>{{ coach(sl.pitch) }}: {{ sl.n }} of {{ p.n }} ({{ pct(sl.share) }})</title>
          {% if sl.full %}
          <circle cx="{{ p.cx }}" cy="{{ p.cy }}" r="{{ p.r }}" fill="{{ sl.color }}"/>
          {% else %}
          <path d="{{ sl.d }}" fill="{{ sl.color }}" stroke="#fff" stroke-width="1.2"/>
          {% endif %}
        </g>
        {% endfor %}
        {% for sl in p.slices if sl.labelled %}
        <text x="{{ sl.label_x }}" y="{{ sl.label_y - 1 }}" class="pl{% if sl.small %} sm{% endif %}">{{ sl.short }}</text>
        <text x="{{ sl.label_x }}" y="{{ sl.label_y + (8 if sl.small else 10) }}" class="pv{% if sl.small %} sm{% endif %}">{{ pct(sl.share) }}</text>
        {% endfor %}
        {% if not p.slices %}
        <text x="{{ p.cx }}" y="{{ p.cy + 4 }}" class="pnone">no pitches</text>
        {% endif %}
      </svg>
      <div class="pien">n={{ "{:,}".format(p.n) }}</div>
    </div>
    {% endfor %}
    {% endfor %}
  </div>

  <h3>Location by pitch <span>catcher's view · % of that pitch to each zone · box = strike zone</span></h3>
  <div class="zones" style="--pitches:{{ c.order|length }}">
    {% for row in c.zones.sides %}
    <div class="rowlab">{{ row.label }}</div>
    {% for m in row.maps %}
    <div class="zm">
      <div class="zt"><i class="sw" style="background:{{ c.colors[m.pitch] }}"></i>{{ m.short }} <span>n={{ "{:,}".format(m.n) }}</span></div>
      {% if m.enough %}
      <div class="zbox" role="img" aria-label="Where his {{ coach(m.pitch)|lower }} goes, {{ row.label }}">
        <div class="zouter">
          {% for z in m.outer %}
          <div class="zo zo{{ z.zone }}{% if z.dark %} zdark{% endif %}" style="background:{{ z.bg }}" title="{{ z.n }} of {{ m.n }}"><b>{{ z.pct if z.pct is not none else "" }}</b></div>
          {% endfor %}
        </div>
        <div class="zinner">
          {% for z in m.inner %}
          <div{% if z.dark %} class="zdark"{% endif %} style="background:{{ z.bg }}" title="{{ z.n }} of {{ m.n }}">{{ z.pct if z.pct is not none else "" }}</div>
          {% endfor %}
        </div>
      </div>
      {% else %}
      <div class="zbox thin"><span>{% if m.n %}too few<br>to map{% else %}not<br>thrown{% endif %}</span></div>
      {% endif %}
    </div>
    {% endfor %}
    {% endfor %}
  </div>

  <div class="three keys">
    {% for side, title in [("L", "Keys vs LHH"), ("R", "Keys vs RHH"), ("both", "Either side")] %}
    <div>
      <h3>{{ title }}</h3>
      <ul>
      {% for k in c.key_lines[side] %}
        <li><b>{{ k.label }}.</b> {{ k.card_text }} <span class="n">n={{ "{:,}".format(k.n) }}</span></li>
      {% else %}
        {% if side == "both" %}
        <li class="dim">No count tell, height tell or recent change clears its bar.</li>
        {% elif c.plan[side] %}
        <li class="dim">Nothing to this side clears its bar: he stays with his usual mix. Read the pies.</li>
        {% else %}
        <li class="dim">Too few pitches to this side to write a key.</li>
        {% endif %}
      {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </div>

  <div class="two byhand">
    <div>
      <h3>Running game <span>video and stopwatch</span></h3>
      <div class="blanks">
        <div>Time to the plate, stretch<span>sec</span></div>
        <div>Slide step, quick pitch<span>notes</span></div>
        <div>Pickoff move, looks<span>notes</span></div>
      </div>
    </div>
    <div>
      <h3>Scout notes <span>video: tipping, tempo, with runners on</span></h3>
      <div class="ruled">{% for _ in range(24) %}<i></i>{% endfor %}</div>
    </div>
  </div>

  <div class="foot">
    {# The last sentence is the split-half check on the pies and maps
       themselves (scripts/replication.py, 55 pitcher-seasons): how far to
       trust a number on this page, said once, on the page. #}
    <span>Whiff = misses per swing. Chase = swings at pitches outside the zone. Max = 99th
      percentile. Pitcher's count = more strikes than balls; hitter's count = more balls
      than strikes. Grey = a thin sample, or a pitch that side barely sees. n = pitches
      behind the line. A key is printed only when it clears its sample and strength bars.
      From one half of a season to the next, a pie slice moves about 4 points and a zone
      cell about 2.</span>
    <span>statcast-advance · Baseball Savant data<br>{{ payload.meta.generated }}</span>
  </div>
</div>
</section>
{% if links %}
<p class="behind">
  One letter page: print it as it is.
  <a href="{{ links.detail }}">The evidence behind this card</a> has his counts, movement,
  location by count, sequencing and release, and what was left off the card.
</p>
{% endif %}

{% else %}
<header class="top">
  <h2>Behind the card — {{ payload.meta.pitcher }}, {{ payload.meta.season }}</h2>
  <div class="sub">
    The evidence for the one-page card, and what was left off it.
    {% if links %}<a href="{{ links.card }}">Back to the card</a>{% endif %}
  </div>
  <div class="sub">
    Throws <b>{{ payload.meta.hand }}</b> ·
    <b>{{ "{:,}".format(payload.meta.pitches) }}</b> pitches ·
    <b>{{ payload.meta.games }}</b> games ·
    <b>{{ "{:,}".format(payload.meta.batters_faced) }}</b> batters faced ·
    {{ payload.meta.league_note }}
  </div>
  {% if payload.meta.seasons|length > 1 %}
  <div class="sub">
    Seasons combined:
    {% for s in payload.meta.seasons %}<b>{{ s.season }}</b> {{ "{:,}".format(s.pitches) }} pitches{% if not loop.last %} · {% endif %}{% endfor %}.
    Tendencies pool both; "Since last season" on the card says what changed.
    {% if payload.meta.excluded_pitches %}{{ "{:,}".format(payload.meta.excluded_pitches) }} pitches of types he no longer throws are left out.{% endif %}
  </div>
  {% endif %}
</header>

{% if payload.data_gaps %}
<div class="gaps">
  <b>Incomplete input.</b>
  {% for gap in payload.data_gaps %}
  <code>{{ gap.column }}</code> is missing, so the {{ gap.affects }} section is
  unavailable.{% endfor %}
  This is a feed column — if this report was built from the cache, re-fetch the
  player-season to populate it.
</div>
{% endif %}

{# ----------------------------------------------------------- count grid
   Drawn by the template, like the dugout card, so it prints and needs no
   script. Colour comes from log2 of the lift, supplied by the payload, so the
   scale is symmetric: 2x and 0.5x are equally far from "his rate". #}
{% set cg = payload.count_grid %}
{% macro lift_bg(l2) -%}
  {%- if l2 is none -%}#eef1f4{%- else -%}
  {%- set t = [[l2, 1.0]|min, -1.0]|max -%}
  {%- if t >= 0 -%}
rgb({{ (247 + (191 - 247) * t)|round|int }},{{ (247 + (94 - 247) * t)|round|int }},{{ (245 + (39 - 245) * t)|round|int }})
  {%- else -%}{%- set u = 0 - t -%}
rgb({{ (247 + (39 - 247) * u)|round|int }},{{ (247 + (104 - 247) * u)|round|int }},{{ (245 + (168 - 245) * u)|round|int }})
  {%- endif -%}{%- endif -%}
{%- endmacro %}
{% if cg.pitches %}
<section class="card">
  <h2>{{ cg.headline or "What he throws in each count, against his own habits" }}</h2>
  <p class="lede">
    Each grid is one pitch, laid out balls down and strikes across, so neighbouring
    counts sit next to each other. Colour is how much more or less often he throws
    that pitch in that count than he does overall — orange more, blue less, white at
    his normal rate. The big number is that ratio; underneath is the pitch's share of
    the count and how many he threw there. An outlined cell stands at least
    {{ "%g"|format(cg.min_z) }} standard errors from his usual rate; the colour of the
    rest could be chance.
  </p>
  {# Tick labels sit at their true positions on the log2 scale: 0.67x and
     1.5x are log2 = -/+0.585, which is 20.7% and 79.3% of the way along. #}
  <div class="cglegend">
    <div class="ramp" style="background:linear-gradient(90deg,{{ lift_bg(-1.0) }},{{ lift_bg(-0.585) }} 20.7%,{{ lift_bg(0) }} 50%,{{ lift_bg(0.585) }} 79.3%,{{ lift_bg(1.0) }})"></div>
    <div class="ticks">
      <span style="left:0%">≤0.5×</span><span style="left:20.7%">0.67×</span>
      <span style="left:50%">his rate</span><span style="left:79.3%">1.5×</span>
      <span style="left:100%">≥2×</span>
    </div>
    <div class="mark"><span class="box"></span>at least {{ "%g"|format(cg.min_z) }} standard errors from his rate</div>
  </div>
  <div class="cgrid">
  {% for p in cg.pitches %}
    <div class="cgpanel">
      <h4>{{ names.get(p.pitch, p.pitch) }}</h4>
      <div class="sub">overall rate {{ "%.0f"|format(p.own_rate * 100) }}%</div>
      <div class="cg">
        <div class="cg-axis"></div>
        {% for s in range(3) %}<div class="cg-head">{{ s }}</div>{% endfor %}
        {% for b in range(4) %}
          <div class="cg-head">{{ b }}</div>
          {% for s in range(3) %}
            {% set cell = p.cells[b ~ "-" ~ s] %}
            {% if not cell.reliable or cell.lift is none %}
            <div class="cgc gated" title="{{ b }}-{{ s }}: {{ cell.count_n }} pitches in this count — too few to read">—</div>
            {% else %}
            {% set t = [[cell.log2_lift, 1.0]|min, -1.0]|max %}
            <div class="cgc{% if t > 0.55 or t < -0.55 %} dark{% endif %}{% if cell.clears %} clear{% endif %}"
                 style="background:{{ lift_bg(cell.log2_lift) }}"
                 title="{{ b }}-{{ s }}: {{ cell.n }} of {{ cell.count_n }} pitches">
              <b>{{ "%.2f"|format(cell.lift) }}×</b>
              <i>{{ "%.0f"|format(cell.share * 100) }}% · n={{ cell.n }}</i>
            </div>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>
      <div class="cg-cap"><span>balls ↓</span><span>strikes →</span></div>
    </div>
  {% endfor %}
  </div>
  <p class="note">
    A dash means fewer than {{ cg.min_count }} pitches were thrown in that count, so
    no share there is worth reading. A near-empty cell in a well-sampled count is
    kept, because "he almost never throws it here" is often the point.
    {% if cg.excluded %}
    Not shown:
    {% for e in cg.excluded %}{{ names.get(e.pitch, e.pitch) }} ({{ "%.0f"|format(e.share * 100) }}%){% if not loop.last %}, {% endif %}{% endfor %}
    — thrown too rarely to read count by count.
    {% endif %}
  </p>
</section>
{% endif %}

{# Movement plot, SVG from the template; layout from charts.movement_layout. #}
{% set mv = payload.movement %}
{% if mv.bubbles %}
<section class="card">
  <h2>{{ mv.headline or "How each pitch moves" }}</h2>
  <p class="lede">
    Each bubble is one pitch: across is horizontal break toward his throwing arm
    (right) or glove side (left), up is ride — how much less it drops than gravity
    alone would make it. Bubble size is how often he throws it; colour is how often
    hitters miss when they swing.
    {% if mv.has_league %}The hollow ring and thin line show where the league's
    average version of each pitch sits, for pitchers of the same hand.{% endif %}
  </p>
  <svg class="svgchart move" viewBox="0 0 {{ mv.width }} {{ mv.height }}" role="img"
       aria-label="Pitch movement: horizontal and vertical break by pitch type">
    <defs>
      <linearGradient id="whiffRamp" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="{{ mv.whiff_ramp[0] }}"/>
        <stop offset="0.5" stop-color="{{ mv.whiff_ramp[1] }}"/>
        <stop offset="1" stop-color="{{ mv.whiff_ramp[2] }}"/>
      </linearGradient>
    </defs>
    {% for t in mv.x_ticks %}
    <line x1="{{ t.x }}" x2="{{ t.x }}" y1="{{ mv.plot.y0 }}" y2="{{ mv.plot.y1 }}" class="{{ 'zero' if t.value == 0 else 'grid' }}"/>
    <text x="{{ t.x }}" y="{{ mv.plot.y1 + 16 }}" text-anchor="middle" class="tick">{{ t.value }}</text>
    {% endfor %}
    {% for t in mv.y_ticks %}
    <line x1="{{ mv.plot.x0 }}" x2="{{ mv.plot.x1 }}" y1="{{ t.y }}" y2="{{ t.y }}" class="{{ 'zero' if t.value == 0 else 'grid' }}"/>
    <text x="{{ mv.plot.x0 - 6 }}" y="{{ t.y + 4 }}" text-anchor="end" class="tick">{{ t.value }}</text>
    {% endfor %}
    <text x="{{ (mv.plot.x0 + mv.plot.x1) / 2 }}" y="{{ mv.height - 8 }}" text-anchor="middle" class="axis">← glove side · horizontal break (in) · arm side →</text>
    <text transform="translate(14,{{ (mv.plot.y0 + mv.plot.y1) / 2 }}) rotate(-90)" text-anchor="middle" class="axis">ride (in) — less drop ↑</text>

    {% for h in mv.league %}
    <line x1="{{ h.cx }}" y1="{{ h.cy }}" x2="{{ h.to_x }}" y2="{{ h.to_y }}" stroke="{{ h.stroke }}" stroke-width="1.2" stroke-dasharray="3 3" opacity=".7"/>
    <circle cx="{{ h.cx }}" cy="{{ h.cy }}" r="6" fill="#fff" stroke="{{ h.stroke }}" stroke-width="1.6" stroke-dasharray="2 2"/>
    {% endfor %}

    {% for b in mv.bubbles|sort(attribute="r", reverse=True) %}
    <circle cx="{{ b.cx }}" cy="{{ b.cy }}" r="{{ b.r }}" fill="{{ b.fill }}" stroke="{{ b.stroke }}" stroke-width="2.5" opacity=".94">
      <title>{{ b.name }}: {{ "%.0f"|format(b.usage * 100) }}% usage, {{ "%.0f"|format((b.whiff_rate or 0) * 100) }}% whiff per swing</title>
    </circle>
    {% endfor %}
    {% for b in mv.bubbles %}
    <text x="{{ b.label_x }}" y="{{ b.label_y }}" text-anchor="middle" class="blab">{{ b.name }}</text>
    <text x="{{ b.label_x }}" y="{{ b.label_y + 13 }}" text-anchor="middle" class="bsub">{% if b.velo is not none %}{{ "%.0f"|format(b.velo) }} mph · {% endif %}{{ "%.0f"|format(b.usage * 100) }}%</text>
    {% endfor %}

    <g transform="translate({{ mv.plot.x1 - 170 }},{{ mv.plot.y0 + 8 }})">
      <rect width="162" height="{{ 46 if mv.has_league else 32 }}" rx="5" fill="#fff" opacity=".9"/>
      <rect x="8" y="8" width="90" height="9" rx="2" fill="url(#whiffRamp)" stroke="#d6dbe0"/>
      <text x="104" y="16" class="tick">whiff / swing</text>
      <text x="8" y="28" class="tick">{{ "%.0f"|format(mv.whiff_lo * 100) }}%</text>
      <text x="98" y="28" class="tick" text-anchor="end">{{ "%.0f"|format(mv.whiff_hi * 100) }}%+</text>
      {% if mv.has_league %}
      <circle cx="13" cy="39" r="4.5" fill="#fff" stroke="#55606b" stroke-width="1.4" stroke-dasharray="2 2"/>
      <text x="24" y="42" class="tick">league average</text>
      {% endif %}
    </g>
  </svg>
  <p class="note">
    Axes are fixed, not fitted to this pitcher, so the same pitch shape lands in the
    same place in every report.
    {% if not mv.has_league %}League-average markers appear once the league tables are
    rebuilt with movement columns.{% endif %}
  </p>
</section>
{% endif %}

<div class="charts">
  <div class="chartbox">
    <h3>Velocity through the outing</h3>
    <p class="lede">
      {% if payload.fatigue.pitch %}His {{ c.coach_names.get(payload.fatigue.pitch, payload.fatigue.pitch) }} only{% else %}One fastball only{% endif %}
      — blending in a slower pitch tracks pitch selection, not fatigue.
      Each point is the average change <em>within</em> an outing from its own
      first pitches, so the line is not moved by which outings lasted.
      Dashed and greyed buckets rest on fewer than
      {{ payload.fatigue.min_outings }} outings.
    </p>
    <div class="holder"><canvas id="fatigueChart"></canvas></div>
    {% if payload.tto %}
    <h3 class="sub3">By trip through the order</h3>
    <div class="scroll"><table id="ttoTable"><thead></thead><tbody></tbody></table></div>
    <p class="note">
      "Vs 1st trip" is the same fastball's velocity, compared inside each outing that
      reached both trips, with the number of outings compared beside it. The
      other columns are plain per-trip figures, and a later trip holds only
      the outings that lasted that long. The third trip is also roughly
      pitches 70 to 100, so this shows what happens late, not why.
    </p>
    {% endif %}
  </div>
  {# Slope chart, drawn as SVG by the template. Coordinates and label
     positions come from charts.slope_layout; nothing is computed here. #}
  {% set ps = payload.platoon_slope %}
  <div class="chartbox">
    <h3>{{ ps.headline or "Usage by batter handedness" }}</h3>
    <p class="lede">
      Each line is one pitch: its share of everything he throws to lefties on the
      left, to righties on the right. A steep line is a pitch whose use depends on
      the hitter's side; a line starting at the floor is one that side barely sees.
    </p>
    {% if ps.pitches %}
    <svg class="svgchart" viewBox="0 0 {{ ps.width }} {{ ps.height }}" role="img"
         aria-label="Pitch usage against left- and right-handed hitters">
      {% for t in ps.ticks %}
      <line x1="44" x2="{{ ps.width - 8 }}" y1="{{ t.y }}" y2="{{ t.y }}" class="grid"/>
      <text x="38" y="{{ t.y + 4 }}" class="tick" text-anchor="end">{{ "%.0f"|format(t.value * 100) }}%</text>
      {% endfor %}
      {% for p in ps.pitches %}
      <g opacity="{{ 1 if p.strong else 0.5 }}">
        <line x1="{{ ps.x_left }}" y1="{{ p.y_L }}" x2="{{ ps.x_right }}" y2="{{ p.y_R }}"
              stroke="{{ p.color }}" stroke-width="{{ 3.2 if p.strong else 2 }}" stroke-linecap="round"/>
        <circle cx="{{ ps.x_left }}" cy="{{ p.y_L }}" r="4.5" fill="{{ p.color }}"/>
        <circle cx="{{ ps.x_right }}" cy="{{ p.y_R }}" r="4.5" fill="{{ p.color }}"/>
        <text x="{{ ps.x_left - 12 }}" y="{{ p.label_y_L + 4 }}" text-anchor="end" class="slab" fill="{{ p.color }}">{{ names.get(p.pitch, p.pitch) }} <tspan font-weight="700">{{ "%.0f"|format(p.usage_L * 100) }}%</tspan></text>
        <text x="{{ ps.x_right + 12 }}" y="{{ p.label_y_R + 4 }}" text-anchor="start" class="slab" fill="{{ p.color }}"><tspan font-weight="700">{{ "%.0f"|format(p.usage_R * 100) }}%</tspan> {{ names.get(p.pitch, p.pitch) }}</text>
      </g>
      {% endfor %}
      <text x="{{ ps.x_left }}" y="{{ ps.height - 12 }}" text-anchor="middle" class="axis">to lefties ({{ "{:,}".format(ps.side_n.L) }})</text>
      <text x="{{ ps.x_right }}" y="{{ ps.height - 12 }}" text-anchor="middle" class="axis">to righties ({{ "{:,}".format(ps.side_n.R) }})</text>
    </svg>
    <p class="note">
      Every line is solid on purpose. Each share is measured over everything he
      threw to that side, so even a pitch one side almost never sees has a
      precise share — a line near the floor is a real near-zero, not a guess.
      Faded lines barely change between sides.
    </p>
    {% else %}
    <p class="nodata">Not enough pitches to both sides to compare.</p>
    {% endif %}
  </div>
</div>

<section class="card">
  <h2>Location</h2>
  <p class="lede">
    Each grid is Savant's, read from the catcher's view: the 3&times;3 is the strike
    zone and the four surrounding regions are outside it. All of them share one colour
    scale, so a cell means the same thing in every panel and across every slice —
    switching the controls does not rescale anything. Each cell carries its own
    percentage and pitch count, because colour alone should not be load-bearing.
  </p>
  <div class="controls">
    <label for="sliceState">Count</label>
    <select id="sliceState">
      <option value="all">All counts</option>
      <option value="ahead">Pitcher's count (he's ahead)</option>
      <option value="even">Even</option>
      <option value="behind">Hitter's count (he's behind)</option>
    </select>
    <label for="sliceHand">Batter</label>
    <select id="sliceHand">
      <option value="all">Both</option>
      <option value="L">To LHH</option>
      <option value="R">To RHH</option>
    </select>
    <label for="sliceMode">Colour</label>
    {# Share first: lift against the whole season is 1.0x everywhere when
       nothing is sliced, so it cannot be the opening view. #}
    <select id="sliceMode">
      <option value="share">Share of the pitch</option>
      <option value="lift">Compared with his usual</option>
    </select>
    <span id="sliceLegend" class="legend-inline"></span>
  </div>
  <div id="zgrid" class="zgrid"></div>
  <p class="note" id="sliceNote"></p>

  {% if payload.location_tells %}
  <h3 style="font-size:13px;margin:22px 0 8px">What the pitch's height gives away</h3>
  <p class="note" id="bandNote" style="margin:0 0 10px"></p>
  <div class="scroll">
    <table id="tellsTable">
      <thead><tr>
        <th>Height</th><th>Pitch</th><th class="num">n</th>
        <th class="num">Chance it's this pitch</th><th class="num">His usual share</th>
        <th class="num">How much more likely</th><th class="num">Strength</th>
      </tr></thead>
      <tbody></tbody>
    </table>
  </div>
  {% endif %}
</section>

<section class="card">
  <h2>Arsenal{% if payload.meta.has_league %} against the league{% endif %}, by batter side</h2>
  <p class="lede">
    What the card's arsenal table leaves out: overall usage, spin, zone rate, whiff
    rate by batter side, and results.
    {% if payload.meta.has_league %}Each "vs Lg" and &Delta; column is his pitch against
    the league's version of the same pitch from the same hand: a pitch thrown well
    above league rate is the defining fact about a pitcher.{% endif %}
    Whiff rate is per swing, not per pitch, and is blank against a side that saw too
    few of the pitch for a rate to mean anything. xwOBA is here and not on the card
    because a pitch's xwOBA in one half of a season says only so much about the other
    (r about 0.6, against 0.9 and up for usage, velocity and movement). Movement and
    velocity range are on the card.
  </p>
  <div class="scroll"><table id="arsenalTable"><thead></thead><tbody></tbody></table></div>
</section>

{# Sequence graph, SVG from the template; layout from charts.sequence_layout.
   Left to right is time: the pitch he just threw, then the pitch that
   followed. Drawn without script so it prints with the rest. #}
{% set sg = payload.sequence_graph %}
<section class="card">
  <h2>Sequencing</h2>
  <h3 class="sec3 first">{{ sg.headline }}</h3>
  <p class="lede">
    Read each panel left to right: the pitch he just threw, then the pitch that
    followed it in the same plate appearance. A line's thickness is how often that
    follow-up came. <b style="color:{{ sg.colors.more }}">Orange</b> is a follow-up that
    comes at least {{ "%.2f"|format(sg.more_lift) }} times as often as that pitch usually
    follows anything; <b style="color:{{ sg.colors.less }}">blue, dashed,</b> is one that
    comes at most {{ "%.1f"|format(sg.less_lift) }} times as often. Grey is within his usual.
  </p>
  <div class="seqgrid">
  {% for p in sg.panels %}
    <div class="seqpanel">
      <h4>{{ p.label }} <span class="n">{{ "{:,}".format(p.total) }} follow-up pitches</span></h4>
      {% if p.enough %}
      <svg class="svgchart seq" viewBox="0 0 {{ p.width }} {{ p.height }}" role="img"
           aria-label="What follows each pitch, {{ p.label|lower }}">
        <defs>
          {% for kind in ["more", "less"] %}
          <marker id="seq-{{ kind }}-{{ p.side }}" markerUnits="userSpaceOnUse"
                  markerWidth="11" markerHeight="10" refX="2" refY="5" orient="auto">
            <path d="M0,0 L11,5 L0,10 z" fill="{{ sg.colors[kind] }}"/>
          </marker>
          {% endfor %}
        </defs>
        <text x="{{ p.x_left }}" y="{{ p.header_y }}" text-anchor="end" class="axis">He just threw</text>
        <text x="{{ p.x_right }}" y="{{ p.header_y }}" text-anchor="start" class="axis">Next pitch</text>
        {% for l in p.lines %}
        <line x1="{{ l.x1 }}" y1="{{ l.y1 }}" x2="{{ l.x2 }}" y2="{{ l.y2 }}"
              stroke="{{ l.stroke }}" stroke-width="{{ l.width }}"
              {% if l.kind %}marker-end="url(#seq-{{ l.kind }}-{{ p.side }})"{% else %}stroke-linecap="round" opacity="0.55"{% endif %}
              {% if l.kind == "less" %}stroke-dasharray="6 4"{% endif %}>
          <title>After a {{ names.get(l.from, l.from) }}, a {{ names.get(l.to, l.to) }} followed {{ l.n }} of {{ l.row_n }} times ({{ "%.0f"|format(l.share * 100) }}%). His usual is {{ "%.0f"|format(l.usual * 100) }}%.</title>
        </line>
        {% endfor %}
        {% for n in p.left %}
        <circle cx="{{ p.x_left }}" cy="{{ n.y }}" r="{{ n.r }}" fill="{{ n.color }}"{% if not n.read %} opacity="0.35"{% endif %}/>
        <text x="{{ p.x_left - n.r - 8 }}" y="{{ n.y - 1 }}" text-anchor="end" class="slab"{% if not n.read %} opacity="0.5"{% endif %}><tspan font-weight="700" fill="{{ n.color }}">{{ names.get(n.pitch, n.pitch) }}</tspan></text>
        <text x="{{ p.x_left - n.r - 8 }}" y="{{ n.y + 12 }}" text-anchor="end" class="tick">{% if n.read %}n={{ n.row_n }}{% else %}n={{ n.row_n }}, too few{% endif %}</text>
        {% endfor %}
        {% for n in p.right %}
        <circle cx="{{ p.x_right }}" cy="{{ n.y }}" r="{{ n.r }}" fill="{{ n.color }}"/>
        <text x="{{ p.x_right + n.r + 8 }}" y="{{ n.y - 1 }}" text-anchor="start" class="slab"><tspan font-weight="700" fill="{{ n.color }}">{{ names.get(n.pitch, n.pitch) }}</tspan></text>
        <text x="{{ p.x_right + n.r + 8 }}" y="{{ n.y + 12 }}" text-anchor="start" class="tick">usual {{ "%.0f"|format(n.usual * 100) }}%</text>
        {% endfor %}
        {% for l in p.lines if l.kind %}
        <text x="{{ l.label_x }}" y="{{ l.label_y }}" text-anchor="middle" class="seqlab" fill="{{ l.stroke }}">{{ l.label }}</text>
        {% endfor %}
      </svg>
      {% if not p.standouts %}
      <p class="seqnone">Nothing stands out to this side: whatever he just threw, the
        next pitch follows his usual mix.</p>
      {% endif %}
      {% else %}
      <p class="nodata">Fewer than {{ sg.row_gate }} follow-up pitches to this side — too few to read.</p>
      {% endif %}
    </div>
  {% endfor %}
  </div>
  <p class="note">
    "n" is how many times the pitch was followed by another in the same plate
    appearance; "usual" is how often a pitch follows anything, to that side. A coloured
    line also has to stand clear of chance, and a pitch with fewer than
    {{ sg.row_gate }} follow-ups sends out no lines. Across 58 pitcher-seasons, 9 in 10
    coloured lines pointed the same way in the other half of the season and about 6 in
    10 were as strong. The count is not held fixed: what a pitch does decides the count
    the next one is thrown in, so part of any line is ordinary count logic.
  </p>

  {# Tunneling: the same follow-ups, read for what the hitter can see. In the
     evidence file, not on the card: see report._build_tunneling. #}
  {% set tn = payload.tunneling %}
  <h3 class="sec3">{{ tn.headline or "Tunneling: where the next pitch is when the hitter has to decide" }}</h3>
  {% if tn.available and tn.rows %}
  <p class="lede">
    The follow-ups above, read for what a hitter can see. He has to decide when the
    ball is about {{ "%.0f"|format(tn.tunnel_ft) }} feet away. Each row is a pitch and the
    one that followed it: how far apart the two leave his hand, where the second is
    at the decision point relative to the first, and how differently it moves after
    that, which the hitter does not get to see before he commits. All three are
    averages of the difference, so where he happened to throw each pitch cancels out.
  </p>
  <div class="scroll"><table id="tunnelTable"><thead></thead><tbody></tbody></table></div>
  <p class="note">
    "Reads as" divides the offset at the decision point by how much his own pitches
    scatter there{% if tn.scatter.L is not none and tn.scatter.R is not none %}
    ({{ "%.1f"|format(tn.scatter.L) }} inches to lefties, {{ "%.1f"|format(tn.scatter.R) }}
    to righties){% endif %}. <b>Same window</b> means where the ball is at that moment
    would pick the right pitch of the two less than 65% of the time; <b>apart early</b>
    means more than 73%. Between the two it gets no word. A pair is listed once it has
    come {{ tn.min_pairs }} times to that side.
  </p>
  <p class="note">
    How far to trust it: across 45 pitcher-seasons, 9 in 10 "same window" pairs stayed
    on that side of the line in the other half of the season and 7 in 10 earned the
    word again; for "apart early" it was 8 in 10 and under 6 in 10. The offset itself
    moves by a median of about an inch and a quarter between halves, which is why it
    is here and not on the card. Late movement and the gap out of the hand barely move
    at all. {{ "%.1f"|format(tn.tunnel_ft) }} feet is a convention: it is where an
    average fastball is about 175 ms from contact, and it is further from contact for
    a slow pitch, so this understates how readable a slow curveball is.
  </p>
  {% elif tn.available %}
  <p class="nodata">No pair of pitches came {{ tn.min_pairs }} times to one side.</p>
  {% else %}
  <p class="nodata">
    This pitcher-season was cached before the trajectory columns were stored, so there
    is nothing to reconstruct a flight from. Fetch it again with <code>--refresh</code>
    to fill this in.
  </p>
  {% endif %}

  <h3 class="sec3">Setups by pitch and height</h3>
  <p class="lede">
    The same question one level down: the pitch and where it was thrown, then what
    followed, and how much more often than usual. This says what he does, not whether
    it works: what happened after a setup — more swings and misses, softer contact —
    came back between halves of a season no better than chance, so it is not shown.
  </p>
  {% if payload.setups %}
  <div class="scroll"><table id="setupTable"><thead></thead><tbody></tbody></table></div>
  <p class="note">
    "How much more likely" is how much the setup pitch raises the chance of the
    follow-up over his usual rate. Rows are the strongest pairs that occurred at
    least {{ payload.setup_min_n }} times, strongest first.
  </p>
  {% else %}
  <p class="nodata">No setup pair cleared the sample gate.</p>
  {% endif %}

  <h3 style="font-size:13px;margin:22px 0 8px">Two-strike approach</h3>
  <div class="scroll"><table id="putawayTable"><thead></thead><tbody></tbody></table></div>
</section>

<section class="card">
  <h2>Release consistency</h2>
  <p class="lede">
    Where each pitch leaves his hand, compared with his fastball. A pitch released
    from a different spot can be picked up out of the hand, before it moves at all.
    A tight spread in a different spot is a tell; a wide spread is a command
    problem.
  </p>
  <div class="scroll"><table id="releaseTable"><thead></thead><tbody></tbody></table></div>
</section>

<footer>
  {{ payload.gates.note }}<br>
  Generated {{ payload.meta.generated }} · statcast-advance · data from Baseball Savant
</footer>
{% endif %}
</div>

{% if page == "detail" %}
<script id="payload" type="application/json">{{ payload_json|safe }}</script>
<script>
const D = JSON.parse(document.getElementById('payload').textContent);
const COLORS = ['#2f6fb2','#c8703a','#4d8c5f','#a8444a','#7a6aa8','#8a7355','#4f7f8f','#96566f'];

const pct  = v => v === null || v === undefined ? '—' : (v * 100).toFixed(1) + '%';
const pct0 = v => v === null || v === undefined ? '—' : (v * 100).toFixed(0) + '%';
const num  = (v, d = 1) => v === null || v === undefined ? '—' : v.toFixed(d);
const int  = v => v === null || v === undefined ? '—' : Math.round(v).toLocaleString();
const sign = (v, d = 3) => v === null || v === undefined ? '—'
                           : (v >= 0 ? '+' : '') + v.toFixed(d);

/* ---------------------------------------------------------------- tables */
/* No table prints a run estimate. The setup and height tables used to carry
   a "Runs" column, coloured red and green, of estimates that do not survive
   correction across everything the report compares: 1 in 287 did. */
/* One renderer for every table. Columns declare their own formatter, so a
   rate can never be printed as a raw float by accident. A formatter gets the
   cell's value and then its whole row, for a cell that prints its own n. */
/* Codes stay in the data, for sorting; the reader sees words. */
const PITCH_FIELDS = new Set(['pitch_type', 'top_pitch', 'setup_pitch', 'next_pitch']);
const HEIGHTS = { UP: 'High', MID: 'Belt', MIDDLE: 'Belt', DOWN: 'Low' };
function words(field, raw) {
  if (PITCH_FIELDS.has(field)) return (D.display_names || {})[raw] || raw;
  if (field === 'band' || field === 'setup_band') return HEIGHTS[raw] || raw;
  return raw;
}

function table(id, rows, cols) {
  const el = document.getElementById(id);
  if (!el) return;
  if (!rows || !rows.length) {
    el.outerHTML = '<p class="nodata">No rows cleared the sample gate.</p>';
    return;
  }
  const present = cols.filter(c => rows.some(r => r[c.f] !== undefined));
  let state = { col: null, dir: 'desc' };

  function draw(data) {
    el.querySelector('thead').innerHTML = '<tr>' + present.map(c =>
      `<th class="${c.n ? 'num' : ''}" data-f="${c.f}">${c.l}${
        state.col === c.f ? (state.dir === 'asc' ? ' ▲' : ' ▼') : ''}</th>`
    ).join('') + '</tr>';

    el.querySelector('tbody').innerHTML = data.map(r => '<tr>' + present.map(c => {
      const raw = r[c.f];
      const txt = c.fmt ? c.fmt(raw, r) : (raw === null || raw === undefined ? '—' : words(c.f, raw));
      let cls = c.n ? 'num' : '';
      if (c.tone && typeof raw === 'number') cls += raw > 0 ? ' pos' : ' neg';
      return `<td class="${cls}">${txt}</td>`;
    }).join('') + '</tr>').join('');

    el.querySelectorAll('th').forEach(th => th.onclick = () => {
      const f = th.dataset.f;
      state.dir = (state.col === f && state.dir === 'desc') ? 'asc' : 'desc';
      state.col = f;
      draw([...data].sort((a, b) => {
        const x = a[f], y = b[f];
        if (x === null || x === undefined) return 1;
        if (y === null || y === undefined) return -1;
        const c = x < y ? -1 : x > y ? 1 : 0;
        return state.dir === 'asc' ? c : -c;
      }));
    });
  }
  draw(rows);
}

/* What the card's arsenal table does not carry: overall usage, the league
   comparisons, spin, zone rate, whiff rate by batter side and xwOBA. Movement
   and chase are on the card and are not repeated here. */
table('arsenalTable', D.arsenal, [
  { f: 'pitch_type', l: 'Pitch' },
  { f: 'n', l: 'n', n: 1, fmt: int },
  { f: 'usage', l: 'Usage', n: 1, fmt: pct },
  { f: 'league_usage', l: 'Lg usage', n: 1, fmt: pct },
  { f: 'usage_ratio', l: 'vs Lg', n: 1, fmt: v => num(v, 2) + 'x' },
  { f: 'velo', l: 'Velo', n: 1, fmt: v => num(v, 1) },
  { f: 'velo_delta', l: 'Δ velo', n: 1, fmt: v => sign(v, 1) },
  { f: 'spin', l: 'Spin', n: 1, fmt: int },
  { f: 'zone_rate', l: 'Zone%', n: 1, fmt: pct0 },
  { f: 'whiff_rate', l: 'Whiff', n: 1, fmt: pct },
  { f: 'whiff_delta', l: 'Δ whiff', n: 1, fmt: v => sign(v, 3) },
  { f: 'whiff_L', l: 'Whiff vs L', n: 1, fmt: pct },
  { f: 'n_L', l: 'n to L', n: 1, fmt: int },
  { f: 'whiff_R', l: 'Whiff vs R', n: 1, fmt: pct },
  { f: 'n_R', l: 'n to R', n: 1, fmt: int },
  { f: 'xwoba', l: 'xwOBA', n: 1, fmt: v => num(v, 3) },
  { f: 'xwoba_delta', l: 'Δ xwOBA', n: 1, fmt: v => sign(v, 3), tone: 1 },
]);

/* The sentence-like cells keep their number as the raw value, so the column
   still sorts by size, and put the direction after it. */
const inches = (v, where) => v === null || v === undefined ? '—'
  : `${num(v, 1)} in${where ? ' ' + where : ''}`;
table('tunnelTable', (D.tunneling || {}).rows, [
  { f: 'stand', l: 'To', fmt: v => v === 'L' ? 'Lefties' : 'Righties' },
  { f: 'pitch_type', l: 'After a' },
  { f: 'next_pitch', l: 'Then the' },
  { f: 'share', l: 'How often', n: 1, fmt: pct0 },
  { f: 'n', l: 'Pairs', n: 1, fmt: int },
  { f: 'release_offset', l: 'Out of the hand', n: 1, fmt: v => inches(v) },
  { f: 'tunnel_offset', l: 'At the decision point', n: 1, fmt: (v, r) => inches(v, r.tunnel_where) },
  { f: 'reading', l: 'Reads as', fmt: v => v || '' },
  { f: 'late_offset', l: 'Late movement', n: 1, fmt: (v, r) => inches(v, r.late_where) },
  { f: 'flight_ms', l: 'Arrives', n: 1,
    fmt: v => v === null || v === undefined ? '—'
      : `${Math.abs(v).toFixed(0)} ms ${v >= 0 ? 'later' : 'sooner'}` },
]);

table('setupTable', D.setups, [
  { f: 'setup_pitch', l: 'Setup' },
  { f: 'setup_band', l: 'Height' },
  { f: 'next_pitch', l: 'Follow-up' },
  { f: 'n', l: 'n', n: 1, fmt: int },
  { f: 'p_next', l: 'Chance next', n: 1, fmt: pct },
  { f: 'baseline_p', l: 'His usual', n: 1, fmt: pct },
  { f: 'freq_lift', l: 'How much more likely', n: 1, fmt: v => num(v, 2) + 'x' },
]);

table('putawayTable', D.putaway, [
  { f: 'pitch_type', l: 'Pitch' },
  { f: 'n', l: 'n', n: 1, fmt: int },
  { f: 'usage', l: 'Usage', n: 1, fmt: pct },
  { f: 'league_usage', l: 'Lg usage', n: 1, fmt: pct },
  { f: 'putaway_rate', l: 'Putaway', n: 1, fmt: pct },
  { f: 'league_putaway', l: 'Lg putaway', n: 1, fmt: pct },
  { f: 'putaway_delta', l: 'vs league', n: 1, fmt: v => sign(v, 3) },
  { f: 'putaway_z', l: 'SEs from league', n: 1, fmt: v => num(v, 1) },
  { f: 'whiff_rate', l: 'Whiff', n: 1, fmt: pct },
]);

/* Seven columns, because this table sits in a half-width box. The paired
   velocity change prints the outings it rests on in the same cell. */
table('ttoTable', (D.tto || []).filter(r => r.reliable), [
  { f: 'tto', l: 'Trip' },
  { f: 'outings', l: 'Outings', n: 1, fmt: int },
  { f: 'velo', l: 'Velo', n: 1, fmt: v => num(v, 1) },
  { f: 'velo_delta', l: 'vs 1st trip', n: 1,
    fmt: (v, r) => v === null || v === undefined ? '—'
      : `${sign(v, 1)} <span class="dim">in ${int(r.velo_pairs)}</span>` },
  { f: 'whiff_rate', l: 'Whiff', n: 1, fmt: pct },
  { f: 'xwoba', l: 'xwOBA', n: 1, fmt: v => num(v, 3) },
  { f: 'batters', l: 'Batters', n: 1, fmt: int },
]);

table('releaseTable', D.release, [
  { f: 'pitch_type', l: 'Pitch' },
  { f: 'n', l: 'n', n: 1, fmt: int },
  { f: 'rel_x', l: 'Rel x (in)', n: 1, fmt: v => num(v, 1) },
  { f: 'rel_z', l: 'Rel z (in)', n: 1, fmt: v => num(v, 1) },
  { f: 'rel_x_sd', l: 'Spread x', n: 1, fmt: v => num(v, 2) },
  { f: 'rel_z_sd', l: 'Spread z', n: 1, fmt: v => num(v, 2) },
  { f: 'arm_angle', l: 'Arm angle', n: 1, fmt: v => num(v, 1) },
  { f: 'dist_from_ref', l: 'From slot (in)', n: 1, fmt: v => num(v, 2) },
]);

table('tellsTable', D.location_tells, [
  { f: 'band', l: 'Height' },
  { f: 'pitch_type', l: 'Pitch' },
  { f: 'n', l: 'n', n: 1, fmt: int },
  { f: 'p_pitch', l: "Chance it's this pitch", n: 1, fmt: pct },
  { f: 'baseline_p', l: 'His usual share', n: 1, fmt: pct },
  { f: 'lift', l: 'How much more likely', n: 1, fmt: v => num(v, 2) + 'x' },
  { f: 'xwoba_when', l: 'xwOBA here', n: 1, fmt: v => num(v, 3) },
  { f: 'score', l: 'Strength', n: 1, fmt: v => num(v, 1) },
]);

/* An outside-the-zone quadrant with its label pinned to the outer corner —
   see the .oz styles for why the corner matters. */
function outerCell(z, bg, labelHtml, title, dark) {
  return `<div class="oz oz-${z}${dark ? ' dark' : ''}" style="background:${bg}"
    title="${title}"><span class="lab">${labelHtml}</span></div>`;
}

/* ------------------------------------------------- sliced zone heatmaps */
/* Counts come from the payload; shares and lift are computed here so any
   combination of count state and handedness can be assembled by summing.
   Shares cannot be averaged across slices of different sizes without
   weighting, so summing counts first is also the only correct way to do it. */
const ZS = D.zone_slices || { cells: [], pitches: [] };

/* Both scales are fixed, never fitted to the current selection. A scale that
   rescales when you change a dropdown makes two slices look identical when
   their magnitudes differ by a factor of three. */
const SHARE_MAX = 0.35;         // share of a pitch going to one zone
const LIFT_MAX  = 3.0;          // and its reciprocal, 0.33x, at the other end

function lerp(a, b, t) {
  return 'rgb(' + a.map((v, i) => Math.round(v + (b[i] - v) * t)).join(',') + ')';
}

/* Sequential single hue: absence to presence. */
function shareColor(v) {
  if (v === null || v === undefined) return '#f2f4f6';
  return lerp([233, 239, 245], [31, 84, 140], Math.min(v / SHARE_MAX, 1));
}

/* Diverging, neutral at 1.0, blue below and orange above — not red/green,
   which about 8% of men cannot separate. Ratios are placed on a log scale so
   2x and 0.5x sit the same distance from the midpoint; on a linear scale
   every "less than usual" cell would crowd into the bottom third. */
function liftColor(v) {
  if (v === null || v === undefined || !isFinite(v)) return '#f2f4f6';
  const span = Math.log(LIFT_MAX);
  const t = Math.max(-1, Math.min(1, Math.log(v) / span));
  const neutral = [247, 247, 245];
  return t >= 0 ? lerp(neutral, [191, 94, 39], t)
                : lerp(neutral, [39, 104, 168], -t);
}

function sliceCells(state, hand) {
  const out = {};
  ZS.cells.forEach(c => {
    if (state !== 'all' && c.s !== state) return;
    if (hand !== 'all' && c.h !== hand) return;
    (out[c.p] = out[c.p] || {})[c.z] = (out[c.p][c.z] || 0) + c.n;
  });
  return out;
}

function drawSlices() {
  const state = document.getElementById('sliceState').value;
  const hand = document.getElementById('sliceHand').value;
  const mode = document.getElementById('sliceMode').value;
  const grid = document.getElementById('zgrid');
  if (!grid) return;

  const byPitch = sliceCells(state, hand);
  const thin = [];

  grid.innerHTML = ZS.pitches.map(pitch => {
    const cells = byPitch[pitch] || {};
    const total = Object.values(cells).reduce((a, b) => a + b, 0);
    const base = (ZS.base || {})[pitch] || {};
    const ok = total >= ZS.min_slice;
    if (!ok) thin.push(pitch);

    const cell = z => {
      const n = cells[z] || 0;
      const share = total ? n / total : null;
      const b = base[z];
      const lift = (share !== null && b) ? share / b : null;
      const v = mode === 'lift' ? lift : share;
      const bg = mode === 'lift' ? liftColor(v) : shareColor(v);
      const label = v === null ? '—'
        : mode === 'lift' ? v.toFixed(1) + 'x' : (v * 100).toFixed(0) + '%';
      const t = v === null ? 0 : mode === 'lift'
        ? Math.abs(Math.log(v || 1e-9) / Math.log(LIFT_MAX))
        : Math.min(v / SHARE_MAX, 1);
      const dark = n > 0 && t >= 0.6;
      const title = `zone ${z}: ${n} pitches, ${total ? ((n / total) * 100).toFixed(1) : 0}%`;
      const text = `<b>${n ? label : ''}</b><i>${n || ''}</i>`;
      if (ZS.outer.includes(z)) return outerCell(z, bg, text, title, dark);
      return `<div class="zcell${dark ? ' dark' : ''}" style="background:${bg}"
        title="${title}">${text}</div>`;
    };

    const name = (D.display_names || {})[pitch] || pitch;
    return `<div class="zpanel${ok ? '' : ' thin'}">
      <h4>${name}</h4>
      <div class="sub${ok ? '' : ' warn'}">
        ${total} pitches${ok ? '' : ' — too thin to read'}
      </div>
      <div class="zmap">
        <div class="outer">${ZS.outer.map(cell).join('')}</div>
        <div class="inner">${ZS.inner.map(cell).join('')}</div>
      </div>
    </div>`;
  }).join('');

  const ramp = mode === 'lift'
    ? `<span class="ramp" style="background:linear-gradient(90deg,
         ${liftColor(1 / LIFT_MAX)},${liftColor(1)},${liftColor(LIFT_MAX)})"></span>
       <span>0.33x &nbsp;·&nbsp; 1.0x &nbsp;·&nbsp; 3x+</span>`
    : `<span class="ramp" style="background:linear-gradient(90deg,
         ${shareColor(0)},${shareColor(SHARE_MAX)})"></span>
       <span>0% &nbsp;·&nbsp; ${(SHARE_MAX * 100).toFixed(0)}%+</span>`;
  document.getElementById('sliceLegend').innerHTML = ramp;

  const explain = mode === 'lift'
    ? 'Lift is this slice’s share of the zone divided by where that pitch '
      + 'goes across the whole season, so 1.0x means the situation does not move '
      + 'it. Orange is more than usual, blue less. Big number is the lift, small '
      + 'number is the pitch count.'
    : 'Share is the percentage of this pitch, in this slice, going to each zone. '
      + 'Mostly it shows where the pitch always goes; switch to lift for what is '
      + 'specific to the slice.';
  // Lift is a slice divided by his whole season. With every count and both
  // sides selected, the slice IS the whole season and every cell is 1.0x by
  // construction, which looks like a finding ("he's perfectly even") and is
  // actually arithmetic. Say so instead of drawing it silently.
  const trivial = mode === 'lift' && state === 'all' && hand === 'all'
    ? ' With every count and both sides selected, lift is 1.0× everywhere by '
      + 'definition — pick a count or a batter side to see what changes.'
    : '';
  const caution = thin.length
    ? ` Hatched panels (${thin.join(', ')}) fall under ${ZS.min_slice} pitches — `
      + 'a thirteen-zone grid of that many is noise however it is coloured.'
    : '';
  document.getElementById('sliceNote').textContent = explain + trivial + caution;
}

if (ZS.pitches.length) {
  ['sliceState', 'sliceHand', 'sliceMode'].forEach(id => {
    document.getElementById(id).onchange = drawSlices;
  });
  drawSlices();
}

const bi = D.band_information || {};
const bandNote = document.getElementById('bandNote');
if (bi.v_band && bandNote) {
  bandNote.textContent =
    `Knowing only the pitch's height removes ${pct(bi.v_band.info_gain_pct)} of ` +
    `the uncertainty about which pitch it is; knowing its quadrant removes ` +
    `${pct((bi.quadrant || {}).info_gain_pct)}. Clearest: ` +
    `${words('band', bi.v_band.top_band)} → ` +
    `${words('pitch_type', bi.v_band.top_pitch)} ${pct0(bi.v_band.top_share)}.`;
}

/* --------------------------------------------------------------- charts */
/* Chart.js is the one external dependency, and only the velocity chart uses
   it. If it is blocked the rest of the page is unaffected, so the page is
   degraded rather than broken. */
if (typeof Chart === 'undefined') {
  document.querySelectorAll('.chartbox .holder').forEach(h => {
    h.innerHTML = '<p class="nodata">This chart needs a network connection ' +
                  'to draw.</p>';
  });
} else {
  Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
  Chart.defaults.font.size = 11;
  Chart.defaults.animation = false;

  const fg = D.fatigue;
  if (fg && fg.buckets.length) {
    // The line is his opening velocity plus the average within-outing change
    // to each bucket (fg.paired), not the plain average of each bucket. The
    // plain average of a late bucket holds only the starts that got that
    // deep, which are the starts that were going well, so it can rise from
    // selection alone; the within-outing change cannot.
    //
    // Buckets built from too few separate outings are still greyed, not
    // removed: few outings is few data points however they are compared, and
    // dropping them would make the curve look better supported than it is.
    const ok = fg.reliable || fg.buckets.map(() => true);
    const series = fg.paired || fg.velo;
    const outings = fg.pairs || fg.outings;
    const solid = '#2f6fb2', faded = '#b9c6d4';

    new Chart(document.getElementById('fatigueChart'), {
      type: 'line',
      data: {
        labels: fg.buckets,
        datasets: [{
          label: 'Fastball velo',
          data: series,
          borderColor: solid,
          backgroundColor: 'rgba(47,111,178,.10)',
          // Straight segments. A smoothed curve implies measurements between
          // buckets that do not exist.
          borderWidth: 2, fill: true, tension: 0,
          pointRadius: 4, pointHoverRadius: 7,
          pointBackgroundColor: ctx => ok[ctx.dataIndex] ? solid : faded,
          pointBorderColor: ctx => ok[ctx.dataIndex] ? solid : faded,
          segment: {
            borderColor: ctx =>
              (ok[ctx.p0DataIndex] && ok[ctx.p1DataIndex]) ? solid : faded,
            borderDash: ctx =>
              (ok[ctx.p0DataIndex] && ok[ctx.p1DataIndex]) ? undefined : [5, 4],
          },
        }],
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        scales: {
          x: { grid: { display: false }, title: { display: true, text: 'pitch of outing' } },
          y: { grid: { color: '#f0f2f4' }, ticks: { callback: v => v.toFixed(1) } },
        },
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: c => `${num(c.parsed.y, 2)} mph`,
              // The outing count is what governs interpretation: a drop seen
              // in three starts is three starts.
              afterLabel: c => `${outings[c.dataIndex]} outings, ` +
                               `n=${fg.n[c.dataIndex]}` +
                               (ok[c.dataIndex] ? ''
                                 : `\nUnder ${fg.min_outings} outings — too few ` +
                                   `to read a change from.`),
            },
          },
        },
      },
    });
  }

}
</script>
{% endif %}
</body>
</html>
